# ───────────────────────── StudyPlan backend config ─────────────────────────
# Copy this file to `.env` and adjust values. `.env` is git-ignored.

# HTTP server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Allowed CORS origins (comma separated). "*" = allow any (dev only).
CORS_ORIGINS=*

# ── Database ────────────────────────────────────────────────────────────────
# DB_CLIENT=sqlite  -> zero-install local file (default, great for dev / demo)
# DB_CLIENT=pg      -> PostgreSQL (production). Fill DATABASE_URL or PG_* vars.
DB_CLIENT=sqlite
SQLITE_FILENAME=./data/studyplan.sqlite3

# PostgreSQL (used only when DB_CLIENT=pg)
DATABASE_URL=
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=studyplan
PG_SSL=false

# ── Auth ────────────────────────────────────────────────────────────────────
# !!! Replace with a long random string (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=30d
BCRYPT_ROUNDS=10

# ── Uploads (group materials) ───────────────────────────────────────────────
UPLOAD_DIR=./data/uploads
UPLOAD_MAX_MB=10

# ── Sync ────────────────────────────────────────────────────────────────────
# Max number of records accepted per table in one /api/sync push.
SYNC_MAX_BATCH=2000
