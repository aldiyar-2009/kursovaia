# ───────────────────────── StudyPlan backend config ─────────────────────────
# Copy this file to `.env` and adjust values. `.env` is git-ignored.

# HTTP server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Allowed CORS origins (comma separated). "*" = allow any (dev only).
CORS_ORIGINS=*

# ── Database ────────────────────────────────────────────────────────────────
# DB_CLIENT=sqlite  -> zero-install local file (default, great for dev / demo)
# DB_CLIENT=pg      -> PostgreSQL (production). Fill DATABASE_URL or PG_* vars.
DB_CLIENT=sqlite
SQLITE_FILENAME=./data/studyplan.sqlite3

# PostgreSQL (used only when DB_CLIENT=pg)
# Supabase: use the Session pooler connection string (port 5432; Knex needs
# transactions, the transaction pooler on 6543 does not fit). Put your own DB
# password in place of [YOUR-PASSWORD]; never commit the real value.
#   DATABASE_URL=postgresql://postgres.ncqwycbtfxboqyhmzbjr:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
# With DATABASE_URL set, SSL is on automatically and the server certificate is verified.
# PG_SSL_CA: Supabase root certificate (Dashboard -> Database Settings -> SSL), path
# relative to backend/. Without it the system CA store is used.
#   PG_SSL_CA=./certs/supabase-ca.crt
# PG_SSL=false disables SSL explicitly (local PostgreSQL only).
DATABASE_URL=
PG_SSL_CA=
# Alternative to DATABASE_URL: separate fields (SSL only when PG_SSL=true)
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=studyplan
PG_SSL=

# ── Auth ────────────────────────────────────────────────────────────────────
# !!! Replace with a long random string (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=30d
BCRYPT_ROUNDS=10

# ── Uploads (group materials) ───────────────────────────────────────────────
UPLOAD_DIR=./data/uploads
UPLOAD_MAX_MB=10

# ── Sync ────────────────────────────────────────────────────────────────────
# Max number of records accepted per table in one /api/sync push.
SYNC_MAX_BATCH=2000
